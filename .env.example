# Public origin your nginx serves. Plan links are built from this, so it must
# match exactly (scheme included) or the links people open will be wrong.
PUBLIC_URL=https://foodgen.instantoffr.com

# Where the container's port 2400 is published. Loopback keeps the app private
# to a host-level nginx. Use 0.0.0.0 if nginx is in another container/host.
BIND_ADDR=0.0.0.0

# Delete plans older than N days. 0 keeps them forever.
RETENTION_DAYS=0
